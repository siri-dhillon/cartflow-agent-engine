# Google GenAI / Vertex AI Configuration (Application Default Credentials - ADC)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-f50badd76af6
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY= (Optional, only needed if not using Vertex AI ADC)

# Shopify Integration
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token

# Bloomreach Discovery Integration
BLOOMREACH_ACCOUNT_ID=your_bloomreach_account_id
BLOOMREACH_DOMAIN_KEY=your_domain_key
BLOOMREACH_AUTH_TOKEN=your_auth_token

# Databricks Integration
DATABRICKS_HOST=https://your-databricks-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_your_pat_token_here

# System Settings
USE_MOCKS=true
